\NeedsTeXFormat{LaTeX2e}
% Shared by templates/paper.tex and examples/示范论文/demo.tex.

\RequirePackage[UTF8,fontset=fandol]{ctex}
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage{booktabs,tabularx,threeparttable}
\RequirePackage{geometry}
\RequirePackage{setspace}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage[section]{placeins}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{hyperref}

\geometry{a4paper,left=2.35cm,right=2.35cm,top=2.10cm,bottom=2.20cm,headheight=14pt}
\setmainfont{TeX Gyre Termes}
% 等宽字体必须换掉默认的 Latin Modern Mono：它没有希腊字母，源码注释里的
% σ、Δ、√ 会整个丢字（实测 lmmono8-regular 报 Missing character）。
% DejaVu Sans Mono 覆盖希腊字母与常见数学符号，且是各发行版的常备字体。
\setmonofont{DejaVu Sans Mono}[Scale=0.85]
\setstretch{1.32}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\setlength{\abovedisplayskip}{7pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{7pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{10pt plus 3pt minus 2pt}
\setlength{\floatsep}{8pt plus 2pt minus 2pt}
\setlength{\intextsep}{8pt plus 2pt minus 2pt}
\renewcommand{\topfraction}{0.90}
\renewcommand{\bottomfraction}{0.80}
\renewcommand{\textfraction}{0.08}
\renewcommand{\floatpagefraction}{0.78}

\definecolor{cumcmblue}{HTML}{1F4E79}
\definecolor{cumcmred}{HTML}{A61B1B}
\hypersetup{colorlinks=true,linkcolor=black,citecolor=black,urlcolor=cumcmblue}

\titleformat{\section}{\centering\heiti\bfseries\zihao{3}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\heiti\bfseries\zihao{4}}{\thesubsection}{0.65em}{}
\titleformat{\subsubsection}{\heiti\bfseries\zihao{-4}}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{16pt plus 2pt minus 2pt}{8pt}
\titlespacing*{\subsection}{0pt}{12pt plus 2pt minus 2pt}{5pt}
\titlespacing*{\subsubsection}{0pt}{9pt plus 2pt minus 1pt}{3pt}

\captionsetup{font=small,labelfont=bf,labelsep=quad,skip=5pt}
\captionsetup[table]{position=top}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}
\graphicspath{{./}}

\setlist{nosep,leftmargin=2.3em,labelsep=0.5em}
\setlist[enumerate,1]{label=\arabic*.,topsep=4pt,itemsep=2pt}
\setlist[itemize,1]{label=\textbullet,topsep=4pt,itemsep=2pt}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\zihao{-5}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\newcommand{\cumcmtitle}[1]{%
  \begin{center}
    \vspace*{-0.6em}
    {\heiti\bfseries\zihao{2} #1\par}
    \vspace{1.0em}
  \end{center}
}

\renewenvironment{abstract}{%
  \par\noindent{\heiti\bfseries\zihao{4} 摘\quad 要：}%
  \zihao{-4}\songti
}{\par\vspace{0.6em}}

\newcommand{\keywords}[1]{%
  \par\noindent{\heiti\bfseries 关键词：}\songti #1\par
  \vspace{0.7em}
}

\newenvironment{modelassumptions}
  {\begin{enumerate}[label=\textbf{假设 \arabic*：},leftmargin=5.8em,labelsep=0.4em]}
  {\end{enumerate}}

\newcommand{\tablenote}[1]{%
  \par\vspace{2pt}\raggedright\zihao{-5}\songti 注：#1
}

\newenvironment{aideclaration}[1][AI 工具使用声明]{%
  \section*{#1}
  \addcontentsline{toc}{section}{#1}
}{\par}

% 附录源码排版。附录带全量代码是近年获奖论文的常态——官方 2023 年 14 篇实测
% 附录占全文 27.6%~72.1%（中位 49.9%，见 analysis/paper-structure.md），
% 正文里只写「程序见支撑材料」等于白丢一半篇幅。
% 用 listings 而非 minted：minted 需要 -shell-escape 和 Python 的 pygments，
% 赛场机器上多一个装不上的依赖就是多一个风险点；listings 是 TeX Live 自带的。
\lstdefinestyle{cumcmcode}{
  basicstyle=\ttfamily\scriptsize,
  breaklines=true,
  breakatwhitespace=false,
  showstringspaces=false,
  numbers=left,
  numberstyle=\tiny\color{gray},
  numbersep=6pt,
  frame=single,
  framerule=0.3pt,
  rulecolor=\color{gray!55},
  keywordstyle=\color{blue!65!black},
  commentstyle=\color{green!42!black},
  stringstyle=\color{purple!68!black},
  extendedchars=true,
  tabsize=4,
  columns=flexible,
  xleftmargin=1.6em,
  aboveskip=0.8em,
  belowskip=0.8em,
}
\lstset{style=cumcmcode}

% \codefile{读取路径}{语言}{显示名}——附录里插入一整个源码文件。
% 读取路径按 .tex 所在目录算，可能是一长串 ../；显示名是给人看的短名，两者必须分开。
\newcommand{\codefile}[3]{%
  \lstinputlisting[language=#2,caption={\texttt{\detokenize{#3}}},label={lst:\detokenize{#3}}]{#1}%
}

\AtBeginDocument{\zihao{-4}\songti}
